{
  "name": "viertel",
  "version": "1.0.0",
  "description": "Viertel — local-only Zeiterfassung PWA für Kanzleien, mit DATEV-Liste (Fork von KIDEON time).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "build:single": "vite build -c vite.single.config.js && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/Viertel.html')\""
  },
  "devDependencies": {
    "vite": "7.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
